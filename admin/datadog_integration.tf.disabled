# Parked until a Datadog API key exists for the rebuilt account. Rename to .tf
# and set TF_VAR_dd_api_key on the admin stack to bring it back.

variable "dd_api_key" {
  type        = string
  description = "API key for the DD integration"
  sensitive   = true
}

variable "dd_site" {
  type        = string
  description = "Datadog site (hostname) to send metrics to."
}

module "datadog" {
  source = "spacelift-io/datadog/spacelift"

  dd_api_key = var.dd_api_key
  dd_site    = var.dd_site
}
